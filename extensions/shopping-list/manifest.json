{
  "manifest_version": 3,
  "name": "MyShoppingList — Add to list (Local test)",
  "version": "0.1.0",
  "description": "Add the current Coles or Woolworths product to your MyShoppingList account.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "storage", "scripting", "alarms"],
  "host_permissions": ["http://localhost/*", "https://www.coles.com.au/*", "https://coles.com.au/*", "https://www.woolworths.com.au/*", "https://woolworths.com.au/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Add to MyShoppingList", "default_popup": "popup.html" }
}
