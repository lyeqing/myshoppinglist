{
  "manifest_version": 3,
  "name": "MyShoppingList — Add to list (Local test)",
  "version": "0.4.0",
  "description": "Add products to MyShoppingList and help refresh shared retailer prices while idle.",
  "minimum_chrome_version": "142",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://www.coles.com.au/*",
    "https://coles.com.au/*",
    "https://www.woolworths.com.au/*",
    "https://woolworths.com.au/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Add to MyShoppingList",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "popup.html" },
  "web_accessible_resources": [
    {
      "resources": ["compact.html"],
      "matches": [
        "https://www.coles.com.au/*",
        "https://coles.com.au/*",
        "https://www.woolworths.com.au/*",
        "https://woolworths.com.au/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coles.com.au/*",
        "https://coles.com.au/*",
        "https://www.woolworths.com.au/*",
        "https://woolworths.com.au/*"
      ],
      "js": ["retailer-panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*"],
      "js": ["website-session.js"],
      "run_at": "document_idle"
    }
  ]
}
