{
  "manifest_version": 3,
  "name": "MyShoppingList Retailer Reader",
  "version": "0.1.0",
  "description": "Process MyShoppingList Coles and Woolworths product and comparison tasks using one browser tab.",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "alarms", "sidePanel"],
  "host_permissions": ["https://www.coles.com.au/*", "https://coles.com.au/*", "https://www.woolworths.com.au/*", "https://woolworths.com.au/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "popup.html" },
  "action": { "default_title": "Open Retailer Reader side panel" }
}
