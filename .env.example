# Server-only preferred transport. Docker: use the API service name, not localhost.
MYSHOPPINGLIST_INTERNAL_API_URL=http://127.0.0.1:5392
# Existing server-side fallback when the internal setting is empty/unset.
# Keep the public HTTPS endpoint available independently for AI/mobile clients.
MYSHOPPINGLIST_API_URL=http://localhost:5392
# Set the actual canonical HTTPS origin at build AND runtime before a public deployment.
# Missing/invalid origin disables indexing/sitemap discovery; rebuild localhost artifacts for deployment.
MYSHOPPINGLIST_PUBLIC_ORIGIN=http://localhost:3001
NEXT_PUBLIC_RELEASE=local
